# ── General ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Run profile ───────────────────────────────────────────────────────────────
# free_tier | standard
RUN_PROFILE=free_tier

# ── Lead targeting ────────────────────────────────────────────────────────────
MAX_LEADS=30
EXPECTED_YIELD_PRIOR=0.20
BUDGET_SAFETY_MULTIPLIER=1.30
MAX_RESEARCH_ROUNDS=20
MAX_ORGS_PER_ROUND=10
MAX_CONCURRENT_ORGS=3
MAX_RESEARCH_STEPS_PER_ORG=25
RUN_TIMEOUT_SECONDS=900

# ── Search ────────────────────────────────────────────────────────────────────
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=your_search_api_key_here
SEARCH_TIMEOUT_SECONDS=20
# SEARCH_CREDIT_BUDGET=1000
MAX_SEARCH_CALLS_HARD_CAP=800
MAX_RESULTS_PER_QUERY=10
SEARCH_CACHE_TTL_SECONDS=86400
MAX_SEARCHES_PER_ORG=3

# ── Fetching ──────────────────────────────────────────────────────────────────
FETCH_TIMEOUT_SECONDS=15
MAX_FETCHES_PER_ORG=10
MAX_TOTAL_FETCH_ATTEMPTS_HARD_CAP=2000
MAX_PAGE_BYTES=2000000
MAX_REDIRECTS=5
FETCH_CACHE_TTL_SECONDS=86400
ROBOTS_CACHE_TTL_SECONDS=86400
USER_AGENT=leadagent/0.1 (+https://example.com/leadagent-policy)

# ── LLM ───────────────────────────────────────────────────────────────────────
LLM_PROVIDER=gemini
LLM_API_KEY=your_google_ai_studio_api_key_here
# LLM_BASE_URL=
LLM_MODEL_PLANNER=gemini-2.0-flash-lite
LLM_MODEL_EXTRACTION=gemini-2.0-flash-lite
LLM_MODEL_RANKING=gemini-2.0-flash-lite
LLM_TIMEOUT_SECONDS=45
MAX_LLM_CALLS_HARD_CAP=150
MAX_LLM_CALLS_PER_ORG=4
MAX_INPUT_CHARS=20000
MAX_OUTPUT_TOKENS=2000
LLM_REQUESTS_PER_MINUTE=8
# LLM_DAILY_REQUEST_CAP=300

# ── PDF ───────────────────────────────────────────────────────────────────────
PDF_MAX_BYTES=20000000
PDF_MAX_PAGES=80
PDF_MAX_TEXT_CHARS=250000
PDF_VISION_ENABLED=false
PDF_VISION_MAX_PAGES=10

# ── Verification ──────────────────────────────────────────────────────────────
EMAIL_POLICY=published_first_party
EMAIL_VALIDATOR_PROVIDER=none
# EMAIL_VALIDATOR_API_KEY=
SMTP_PROBE_ENABLED=false
ALLOW_FREE_EMAIL_FOR_COLLEGE=true
VERIFICATION_CACHE_TTL_SECONDS=86400
OFFICIAL_DOMAIN_TRUST_THRESHOLD=0.70
OFFICIAL_DOMAIN_TENTATIVE_THRESHOLD=0.40
PROFILE_NAME_MATCH_THRESHOLD=0.85
PROFILE_ORG_MATCH_THRESHOLD=0.75
EMAIL_CONTEXT_WINDOW_CHARS=500

# ── Output / Google Sheets ────────────────────────────────────────────────────
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service_account.json
GOOGLE_SHEETS_LEADS_TAB=Leads
GOOGLE_SHEETS_AUDIT_TAB=Audit
GOOGLE_SHEETS_RUN_LOG_TAB=Run Log
SHEETS_BATCH_SIZE=20

# ── Orchestration (LangGraph) ─────────────────────────────────────────────────
CHECKPOINT_DB_PATH=./.leadagent/checkpoints.sqlite
APP_DB_PATH=./.leadagent/app.sqlite
# MAX_CONCURRENT_ORGS already declared above
# ORG_RECURSION_LIMIT and TOP_RECURSION_LIMIT are derived; not user-configurable
# LANGGRAPH_THREAD_ID is always the run_id; not user-configurable
